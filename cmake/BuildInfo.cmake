# Generates build_info.h containing the project version and the build
# timestamp. Invoked at build time (see CMakeLists.txt) so the timestamp
# reflects the moment the build command was executed.
#
# Required -D variables:
#   RDSM_VERSION - project version string (e.g. 0.9)
#   BINARY_DIR   - CMAKE_BINARY_DIR; the header is written to <BINARY_DIR>/generated/
#
# The timestamp is rendered as a 12-hour clock to the second, e.g.
# "2026-10-06 07:52:59 PM". CMake's string(TIMESTAMP) does not support the
# %p (AM/PM) specifier, so the 24-hour value is converted here.

if(NOT DEFINED RDSM_VERSION OR NOT DEFINED BINARY_DIR)
    message(FATAL_ERROR "BuildInfo.cmake requires -DRDSM_VERSION and -DBINARY_DIR")
endif()

# Single 24-hour timestamp; parsed and converted below. The format is fixed
# width ("YYYY-MM-DD HH:MM:SS"), so parse by position.
string(TIMESTAMP _ts "%Y-%m-%d %H:%M:%S")
# _ts = "2026-10-06 07:52:59"
string(SUBSTRING "${_ts}" 0 10 _date)    # 2026-10-06
string(SUBSTRING "${_ts}" 11 2 _hour24)  # 07
string(SUBSTRING "${_ts}" 14 2 _min)     # 52
string(SUBSTRING "${_ts}" 17 2 _sec)     # 59

# Strip a leading zero so math() sees a plain decimal (e.g. "07" -> "7").
string(SUBSTRING "${_hour24}" 0 1 _h0)
string(SUBSTRING "${_hour24}" 1 1 _h1)
if(_h0 STREQUAL "0")
    set(_hour24 "${_h1}")
endif()

# Convert the 24-hour hour to a 12-hour hour plus AM/PM.
math(EXPR _hour12 "${_hour24} % 12")
if(_hour12 EQUAL 0)
    set(_hour12 12)
endif()
if(_hour24 LESS 12)
    set(_ampm "AM")
else()
    set(_ampm "PM")
endif()
if(_hour12 LESS 10)
    set(_hour12 "0${_hour12}")
endif()

set(RDSM_BUILD_TIMESTAMP "${_date} ${_hour12}:${_min}:${_sec} ${_ampm}")

set(OUT_DIR "${BINARY_DIR}/generated")
file(MAKE_DIRECTORY "${OUT_DIR}")
file(WRITE "${OUT_DIR}/build_info.h"
"#pragma once

// Auto-generated by cmake/BuildInfo.cmake at build time. Do not edit.
#define RDSM_VERSION \"${RDSM_VERSION}\"
#define RDSM_BUILD_TIMESTAMP \"${RDSM_BUILD_TIMESTAMP}\"
")
